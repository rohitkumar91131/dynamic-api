# ===== Core =====
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=dynamicdb
PORT=10000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# ===== Kira AI (https://kiraai.vn) =====
KIRA_API_KEY=kira_your_api_key_here
KIRA_BASE_URL=https://kiraai.vn/api/v1
KIRA_MODEL=kira-3.5-flash
KIRA_IMAGE_MODEL=kira-3.0-image
KIRA_TTS_MODEL=kira-3.0-flash-tts
# Optional: override AI prompts dynamically via env (otherwise defaults)
# KIRA_TAG_PROMPT=Your custom tag prompt
# KIRA_ANALYSIS_PROMPT=Your custom analysis prompt

# ===== SMTP Gmail OTP (for personal use) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail@gmail.com
# Only this email can request OTP and create API keys (your personal gmail)
ADMIN_EMAIL=your_gmail@gmail.com
# Secret admin panel path - keep random & private
ADMIN_URL=/admin-secure-xyz123
